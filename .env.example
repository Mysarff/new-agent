# Copy to .env only on first setup. Keep credentials local; never commit .env.
# Chat Completions provider with tools/tool_calls support. Required for Agent chat.
# Example BASE_URL: https://your-provider.example/v1
SMARTVOYAGE_BASE_URL=
SMARTVOYAGE_API_KEY=
SMARTVOYAGE_MODEL=

# Optional, only for a provider/model that supports the enable_thinking parameter.
# Empty: do not send it (provider default). false: disable thinking. true: enable.
# Benchmark both modes before choosing; unsupported providers may reject it.
SMARTVOYAGE_ENABLE_THINKING=

# No key is needed for the current Open-Meteo public weather/geocoding adapter.

# Optional: Amap Web Service key with place search permission.
AMAP_API_KEY=

# Optional: live search for recent travel announcements. Local RAG is a snapshot.
TAVILY_API_KEY=

# Optional: OpenAI-compatible embeddings. Set MODEL to enable.
# Blank embedding BASE_URL/API_KEY inherit the chat provider values above.
# Run: python -m SmartVoyage.main ingest --dense
SMARTVOYAGE_EMBEDDING_BASE_URL=
SMARTVOYAGE_EMBEDDING_API_KEY=
SMARTVOYAGE_EMBEDDING_MODEL=

# Optional: your authorized read-only supplier adapter exposing GET /tickets.
# This is NOT a universal key slot for 12306/Ctrip/airlines. See README contract.
# External endpoints must use HTTPS; HTTP is allowed for localhost development.
SMARTVOYAGE_TICKET_BASE_URL=
SMARTVOYAGE_TICKET_API_KEY=

# App config: agents, tool access, ports, budgets, and knowledge paths.
SMARTVOYAGE_CONFIG=config/travel.json

# SMARTVOYAGE_A2A is managed by python -m SmartVoyage.stack.
# Leave it unset for the standalone streamlit mode; do not force it to 0 here.
